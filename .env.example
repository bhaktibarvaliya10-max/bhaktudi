# BloomDeck AI Environment Variables
PORT=3000

# Optional: Google Gemini API Key
# If not provided, BloomDeck AI automatically uses its built-in
# Educational Pedagogical NLP Synthesizer to create structured presentations.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
